# Copy to .env.local for local development. Every variable is optional.

# --- Share links (public, inlined into the client bundle) ---

# URL of the launch post on X. When set, share texts link to it ({launchTweetUrl},
# {launchTweetUrlOrGameUrl}); when unset or not an http(s) URL, they link to the game.
NEXT_PUBLIC_LAUNCH_TWEET_URL=

# Canonical game URL printed on cards and in share texts.
# Unset or invalid: inferred from window.location.origin.
NEXT_PUBLIC_GAME_URL=

# --- Meme art (server only, never exposed to the client) ---

# Key for an OpenAI-images-compatible provider. Used by scripts/generate-art.mjs
# and, if MEME_ART_RUNTIME=1, by the /api/meme-art route.
MEME_ART_API_KEY=

# Provider base URL; the request goes to {base}/images/generations.
MEME_ART_BASE_URL=https://argolink.io/v1

# Image model name.
MEME_ART_MODEL=gpt-image-2

# Set to 1 to let /api/meme-art generate art at runtime ("Enhance art" button).
# Off by default so a public deploy cannot burn credits; the build-time script
# does not need it.
MEME_ART_RUNTIME=0
